# --- Google login ---
# Create at console.cloud.google.com > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application.
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict sign-in to your Workspace domain. Leave blank to allow any
# Google account (not recommended once this leaves your laptop).
ALLOWED_EMAIL_DOMAIN=themirailabs.com

# Comma-separated emails that get the admin role automatically, on
# every sign-in (not just the first). Put yourself here so there's
# always at least one admin without a manual DB edit.
ADMIN_EMAILS=ankit@themirailabs.com

# --- Secrets ---
# Signs the session cookie. Any random string works:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Encrypts each user's stored Anthropic key at rest. Must be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# --- Fireflies & Google Drive ---
# These are NOT set here anymore. Each project/team sets its own
# Fireflies API key and Drive service-account credentials from the
# dashboard itself (the "Team & keys" panel next to the project
# selector) - separately encrypted per project, not a single shared
# backend value. There's nothing to configure in this file for either.

# --- Extraction fallback ---
# Optional server-wide key, used only if a signed-in user hasn't set
# their own. Leave blank to force everyone onto their own key.
ANTHROPIC_API_KEY=

# --- Database ---
# Leave unset to use local SQLite. Point this at Postgres once you
# deploy - most managed providers hand you a "postgres://" URL, which
# database.py normalizes automatically.
DATABASE_URL=

# --- Deployment ---
# Set to "true" once you're serving over HTTPS (any real cloud host).
# Leave "false" for local http://localhost development - browsers
# refuse secure cookies over plain HTTP, which would lock you out.
COOKIE_SECURE=false
