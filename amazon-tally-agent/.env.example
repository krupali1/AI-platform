# One or a few username:password pairs, comma-separated - the whole
# team shares these to sign in. Leave both this and APP_USERNAME/
# APP_PASSWORD unset to run with auth disabled (local dev only).
AUTH_USERS=team:changeme

# Simpler alternative to AUTH_USERS if you only need one shared login:
# APP_USERNAME=team
# APP_PASSWORD=changeme

# Random secret for signing the session cookie.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to true once served over HTTPS.
COOKIE_SECURE=false

# Optional - only needed for the "Suggest with AI" rule helper.
# Without it, that button returns a clearly-labeled demo suggestion.
ANTHROPIC_API_KEY=

# Optional - only needed for the "Email the sheet" action. Get an API
# key from https://resend.com and verify a sending domain there first;
# RESEND_FROM_EMAIL must be an address on that verified domain.
# Without both set, the email button returns a clear "not configured"
# error instead of failing mysteriously.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional - defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
